    function updateDropdownIcon() {
        const select = document.getElementById('providerName');
        const iconContainer = document.getElementById('providerDropdownIcon');
        const selectedValue = select.value;
        iconContainer.innerHTML = providerIcons[selectedValue] || providerIcons['default'];
    }

    function refreshProviders() { location.reload(); }
    
    function showAddProviderModal() {
        document.getElementById('providerModalTitle').innerHTML = 'Add AI Provider';
        document.getElementById('providerForm').reset();
        document.getElementById('editProviderId').value = '';
        updateDropdownIcon();
        
        document.querySelectorAll('.modality-checkbox').forEach(cb => cb.checked = false);
        
        document.getElementById('providerModal').classList.remove('hidden');
    }
    
    function editProvider(id) {
        const card = document.getElementById(`provider-${id}`);
        if (!card) return;

        document.getElementById('providerModalTitle').innerHTML = 'Edit AI Provider';
        document.getElementById('editProviderId').value = id;
        document.getElementById('providerName').value = card.dataset.name;
        document.getElementById('displayName').value = card.dataset.displayName;
        document.getElementById('priority').value = card.dataset.priority;
        document.getElementById('baseUrl').value = card.dataset.baseUrl || '';

        const modalities = card.dataset.modalities ? card.dataset.modalities.split(',') : [];
        document.querySelectorAll('.modality-checkbox').forEach(cb => {
            cb.checked = modalities.includes(cb.value);
        });

        updateDropdownIcon();
        document.getElementById('providerModal').classList.remove('hidden');
    }

    async function submitProvider(e) {
        e.preventDefault();
        const id = document.getElementById('editProviderId').value;
        
        const checkboxes = document.querySelectorAll('.modality-checkbox:checked');
        const supportedModalities = Array.from(checkboxes).map(cb => cb.value);

        const payload = {
            name: document.getElementById('providerName').value,
            displayName: document.getElementById('displayName').value,
            priority: parseInt(document.getElementById('priority').value, 10),
            baseUrl: document.getElementById('baseUrl').value,
            supportedModalities
        };

        const url = id ? `/admin/api/providers/${id}` : `/admin/api/providers`;
        const method = id ? 'PUT' : 'POST';

        try {
            showLoading();
            const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if(!res.ok) throw new Error(await res.text());
            
            showToast(id ? 'Provider updated successfully' : 'Provider added successfully', 'success');
            setTimeout(() => window.location.reload(), 800);
        } catch (err) {
            hideLoading();
            showToast('Failed to save provider context.', 'error');
        }
    }
    
    function closeProviderModal() { document.getElementById('providerModal').classList.add('hidden'); }
    
    function deleteProvider(id, name) {
        deleteProviderId = id;
        document.getElementById('deleteProviderName').textContent = name;
        document.getElementById('deleteModal').classList.remove('hidden');
    }

    async function confirmDelete() {
        if(!deleteProviderId) return;
        try {
            showLoading();
            const res = await fetch(`/admin/api/providers/${deleteProviderId}`, { method: 'DELETE' });
            
            if(!res.ok) throw new Error(await res.text());
            
            showToast('Provider purged from cluster', 'success');
            setTimeout(() => window.location.reload(), 800);
        } catch(err) {
            hideLoading();
            closeDeleteModal();
            showToast('Failed to delete provider (Ensure all usage logs are cleared first)', 'error');
        }
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
        deleteProviderId = null;
    }
    
    function showApiKeyModal(providerId, providerName) {
        currentProviderId = providerId;
        document.getElementById('apiKeyModalTitle').innerHTML = `Set API Key — ${providerName}`;
        document.getElementById('apiKeyProviderId').value = providerId;
        document.getElementById('apiKeyInput').value = '';
        document.getElementById('testResult').style.display = 'none';
        document.getElementById('apiKeyModal').classList.remove('hidden');
    }

    async function submitApiKey(e) {
        e.preventDefault();
        const id = document.getElementById('apiKeyProviderId').value;
        const apiKey = document.getElementById('apiKeyInput').value;
        
        try {
            showLoading();
            const res = await fetch(`/admin/api/providers/${id}/key`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ apiKey })
            });
            
            if(!res.ok) throw new Error('Failed to save key structure');
            
            showToast('API Key encrypted and mounted successfully', 'success');
            setTimeout(() => window.location.reload(), 800);
        } catch (err) {
            hideLoading();
            showToast(err.message, 'error');
        }
    }

    async function testKeyBeforeSave() {
        const id = document.getElementById('apiKeyProviderId').value;
        const apiKey = document.getElementById('apiKeyInput').value;
        const resultDiv = document.getElementById('testResult');
        const messageDiv = document.getElementById('testMessage');
        
        resultDiv.style.display = 'block';
        messageDiv.className = 'text-xs p-2.5 rounded border font-semibold bg-slate-100 text-slate-600 border-slate-200';
        messageDiv.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Pinging provider endpoint...';

        try {
            const res = await fetch(`/admin/api/providers/${id}/test`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ apiKey })
            });
            const data = await res.json();
            
            if(data.success) {
                messageDiv.className = 'text-xs p-2.5 rounded border font-semibold bg-emerald-50 text-emerald-700 border-emerald-200';
                messageDiv.innerHTML = `<i class="fas fa-check-circle mr-2"></i>${data.message}`;
            } else {
                messageDiv.className = 'text-xs p-2.5 rounded border font-semibold bg-rose-50 text-rose-700 border-rose-200';
                messageDiv.innerHTML = `<i class="fas fa-exclamation-triangle mr-2"></i>${data.message}`;
            }
        } catch (err) {
            messageDiv.className = 'text-xs p-2.5 rounded border font-semibold bg-rose-50 text-rose-700 border-rose-200';
            messageDiv.innerHTML = `<i class="fas fa-exclamation-triangle mr-2"></i>Connection routing failed`;
        }
    }

    async function testConnection(id) {
        try {
            showLoading();
            const res = await fetch(`/admin/api/providers/${id}/test`, { method: 'POST' });
            const data = await res.json();
            hideLoading();
            
            if(data.success) {
                showToast(data.message, 'success');
            } else {
                showToast(data.message, 'error');
            }
        } catch (err) {
            hideLoading();
            showToast('Live connection test dropped', 'error');
        }
    }
    
    function closeApiKeyModal() {
        document.getElementById('apiKeyModal').classList.add('hidden');
        currentProviderId = null;
    }
    
    function showLoading() { document.getElementById('loadingOverlay').classList.remove('hidden'); }
    function hideLoading() { document.getElementById('loadingOverlay').classList.add('hidden'); }
</script>